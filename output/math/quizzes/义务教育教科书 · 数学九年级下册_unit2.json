      "point": "比例线段与相似三角形判定",
      "core_concept": "平行于三角形一边的直线截其他两边，所得三角形与原三角形相似；两角对应相等、两边成比例且夹角相等、三边成比例都可判定相似。",
      "key_formula": "两角对应相等 ⇒ 相似",
      "common_mistakes": [
        "把“夹角”写成“对角”。"
      ],
      "tips": "AA 是最常用的判定。"
    },
    {
      "point": "相似三角形的性质",
      "core_concept": "相似三角形对应线段（高、中线、角平分线）之比等于相似比；周长比等于相似比；面积比等于相似比的平方。",
      "key_formula": "面积比 $=k^2$",
      "common_mistakes": [
        "面积比误写成 $k$。"
      ],
      "tips": "记住平方关系。"
    },
    {
      "point": "位似",
      "core_concept": "位似图形是相似图形，对应点连线交于一点（位似中心）。以原点为位似中心、相似比为 $k$ 时，对应点坐标为原来的 $k$ 倍或 $-k$ 倍。",
      "key_formula": "$(x,y)\\to(kx,ky)$",
      "common_mistakes": [
        "忽略 $-k$ 的情形。"
      ],
      "tips": "注意位似中心两侧各有一解。"
    }
