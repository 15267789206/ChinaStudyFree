  "knowledge_summary": [
    {
      "point": "单项式与多项式",
      "core_concept": "数与字母的积是单项式；数字因数是系数，各字母指数之和是次数。几个单项式的和是多项式。",
      "key_formula": "单项式次数 = 各字母指数和",
      "common_mistakes": [
        "把 $\\pi$ 当字母。"
      ],
      "tips": "先写成乘积再数次数。"
    },
    {
      "point": "同类项与合并",
      "core_concept": "所含字母相同且相同字母指数也相同的项是同类项；合并时系数相加，字母与指数不变。",
      "key_formula": "$ax+bx=(a+b)x$",
      "common_mistakes": [
        "把 $x^2$ 与 $x$ 当同类项。"
      ],
      "tips": "先标同类项再合并。"
    },
    {
      "point": "去括号与整式加减",
      "core_concept": "括号前是“+”，去括号各项不变号；括号前是“−”，去括号各项都变号。整式加减 = 去括号 + 合并同类项。",
      "key_formula": "$a-(b-c)=a-b+c$",
      "common_mistakes": [
        "括号前是减号时只变第一项符号。"
      ],
      "tips": "把括号连同前面的符号一起处理。"
    }
  ],
