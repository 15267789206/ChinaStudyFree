    {
      "point": "指数与指数函数",
      "core_concept": "$a^{\\frac mn}=\\sqrt[n]{a^m}(a>0)$。指数函数 $y=a^x(a>0,a\\ne1)$ 过定点 $(0,1)$；$a>1$ 递增，$0<a<1$ 递减。",
      "key_formula": "$a^0=1$，$a^{-n}=\\frac{1}{a^n}$",
      "common_mistakes": [
