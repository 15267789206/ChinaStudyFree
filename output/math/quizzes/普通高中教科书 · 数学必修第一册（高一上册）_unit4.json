      ],
      "tips": "负指数取倒数。"
    },
    {
      "point": "对数与对数函数",
      "core_concept": "$\\log_a(MN)=\\log_aM+\\log_aN$，$\\log_a\\frac MN=\\log_aM-\\log_aN$，$\\log_aM^n=n\\log_aM$。对数函数 $y=\\log_ax$ 过定点 $(1,0)$。",
      "key_formula": "$\\log_a a=1$，$\\log_a1=0$",
      "common_mistakes": [
