  "knowledge_summary": [
    {
      "point": "平方根与算术平方根",
      "core_concept": "若 $x^2 = a$，则 $x$ 是 $a$ 的平方根。正平方根叫算术平方根。$a > 0$ 时有两个平方根，$\\sqrt{a}$ 只取正值。",
      "key_formula": "$\\sqrt{a^2} = |a|$",
      "common_mistakes": [
        "写成 $\\sqrt{a^2}=a$。"
      ],
      "tips": "注意绝对值。"
    },
    {
      "point": "立方根与无理数",
      "core_concept": "$\\sqrt[3]{a}$ 表示 $a$ 的立方根，$\\sqrt[3]{-8}=-2$。无理数不能表示为分数形式，如 $\\sqrt{2}$、$\\pi$。",
      "key_formula": "$\\sqrt[3]{a^3}=a$",
      "common_mistakes": [
        "认为立方根一定是正数。"
      ],
      "tips": "立方根有正有负。"
    }
  ],
