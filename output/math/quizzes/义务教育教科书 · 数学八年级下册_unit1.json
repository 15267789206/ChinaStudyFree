  "knowledge_summary": [
    {
      "point": "二次根式的概念与性质",
      "core_concept": "形如 $\\sqrt{a}(a\\ge0)$ 的式子叫二次根式；$\\sqrt{a}\\ge0$，$(\\sqrt{a})^2=a$，$\\sqrt{a^2}=|a|$。",
      "key_formula": "$\\sqrt{a^2}=|a|$",
      "common_mistakes": [
        "忽略被开方数非负的条件。"
      ],
      "tips": "先看被开方数是否非负。"
    },
    {
      "point": "二次根式的乘除",
      "core_concept": "$\\sqrt{a}\\cdot\\sqrt{b}=\\sqrt{ab}(a\\ge0,b\\ge0)$；$\\frac{\\sqrt{a}}{\\sqrt{b}}=\\sqrt{\\frac ab}(a\\ge0,b>0)$。化简结果要求分母不含根号、被开方数不含能开得尽方的因数。",
      "key_formula": "$\\sqrt{ab}=\\sqrt a\\cdot\\sqrt b$",
      "common_mistakes": [
        "化简不彻底。"
      ],
      "tips": "把被开方数分解出完全平方因数。"
    },
    {
      "point": "二次根式的加减",
      "core_concept": "先把各二次根式化为最简二次根式，再合并同类二次根式（被开方数相同）。",
      "key_formula": "$a\\sqrt m+b\\sqrt m=(a+b)\\sqrt m$",
      "common_mistakes": [
        "把 $\\sqrt2+\\sqrt3$ 合并为 $\\sqrt5$。"
      ],
      "tips": "只有同类二次根式才能合并。"
    }
  ],
