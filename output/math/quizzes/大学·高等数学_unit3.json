    {
      "point": "不定积分与定积分",
      "core_concept": "$\\int x^n dx=\\frac{x^{n+1}}{n+1}+C(n\\ne-1)$。定积分 $\\int_a^b f(x)dx=F(b)-F(a)$，几何意义是曲边梯形的面积。",
      "key_formula": "$\\int_a^b f(x)dx=F(b)-F(a)$",
      "common_mistakes": [
        "不定积分漏写常数 C。"
      ],
      "tips": "不定积分必须加 C。"
    },
    {
      "point": "定积分的应用",
      "core_concept": "由 $y=f(x)$、$x=a$、$x=b$ 及 $x$ 轴围成的曲边梯形面积为 $\\int_a^b|f(x)|dx$。",
      "key_formula": "$S=\\int_a^b|f(x)|dx$",
      "common_mistakes": [
        "忽略函数在区间内变号。"
      ],
      "tips": "先讨论符号或加绝对值。"
    }
