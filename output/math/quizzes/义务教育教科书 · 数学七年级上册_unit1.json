  "knowledge_summary": [
    {
      "point": "有理数与数轴",
      "core_concept": "整数和分数统称有理数。规定了原点、正方向、单位长度的直线叫数轴；数轴上右边的数总比左边的大。",
      "key_formula": "$|a|$ 表示 $a$ 到原点的距离",
      "common_mistakes": [
        "误以为0不是有理数。",
        "比较负数时忽略绝对值：$-5<-3$。"
      ],
      "tips": "比较两个负数，绝对值大的反而小。"
    },
    {
      "point": "有理数的加减法",
      "core_concept": "同号相加取相同符号并把绝对值相加；异号相加取绝对值较大加数的符号，用较大绝对值减较小绝对值。减去一个数等于加上它的相反数。",
      "key_formula": "$a-b=a+(-b)$",
      "common_mistakes": [
        "异号相加符号取错。"
      ],
      "tips": "减法统一成加法再算。"
    },
    {
      "point": "有理数的乘除与乘方",
      "core_concept": "两数相乘同号得正、异号得负，绝对值相乘。除以非零数等于乘它的倒数。$a^n$ 表示 $n$ 个 $a$ 相乘。",
      "key_formula": "$a\\div b=a\\times\\frac1b\\ (b\\ne0)$",
      "common_mistakes": [
        "$-2^2=-4$ 与 $(-2)^2=4$ 混淆。"
      ],
      "tips": "先定符号，再算绝对值。"
    }
  ],
