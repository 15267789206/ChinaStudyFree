  "knowledge_summary": [
    {
      "point": "列代数式与代数式的值",
      "core_concept": "用字母表示数书写规范：数字与字母相乘、数字写在前面；代数式求值就是代入数值计算。",
      "key_formula": "速度 $v=\\frac st$",
      "common_mistakes": [
        "书写顺序不规范（a3）。"
      ],
      "tips": "数字在前、字母在后。"
    },
    {
      "point": "整式与合并同类项",
      "core_concept": "单项式的数字因数是系数，所有字母指数之和是次数。几个单项式的和是多项式。同类项合并时系数相加。",
      "key_formula": "$ax+bx=(a+b)x$",
      "common_mistakes": [
        "把 $x^2$ 与 $x$ 当同类项。"
      ],
      "tips": "先标同类项再合并。"
    },
    {
      "point": "整式的加减",
      "core_concept": "括号前是「+」去括号不变号，括号前是「−」去括号都变号；整式加减步骤：去括号、合并同类项。",
      "key_formula": "$a-(b-c)=a-b+c$",
      "common_mistakes": [
        "括号前是减号时只变第一项。"
      ],
      "tips": "把括号连同前面符号一起处理。"
    }
  ],
