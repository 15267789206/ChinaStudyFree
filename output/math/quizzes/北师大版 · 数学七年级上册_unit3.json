  "knowledge_summary": [
    {
      "point": "字母表示数与代数式求值",
      "core_concept": "用字母表示数时书写规范：数字写在字母前面，如 $3a$；代数式求值就是代入数值计算。",
      "key_formula": "速度 $v=\\frac st$",
      "common_mistakes": [
        "书写顺序不规范（a3）。"
      ],
      "tips": "数字在前、字母在后。"
    },
    {
      "point": "整式与合并同类项",
      "core_concept": "单项式的数字因数是系数，所有字母指数之和是次数。同类项字母相同且相同字母指数相同，合并时系数相加。",
      "key_formula": "$5a^2b-3a^2b=2a^2b$",
      "common_mistakes": [
        "把 $a^2$ 与 $a$ 当同类项。"
      ],
      "tips": "先判断是否同类项。"
    },
    {
      "point": "去括号与整式加减",
      "core_concept": "括号前是「+」，去括号各项不变号；括号前是「−」，去括号各项都变号。整式加减 = 去括号 + 合并同类项。",
      "key_formula": "$a-(b-c)=a-b+c$",
      "common_mistakes": [
        "括号前是减号时只变第一项符号。"
      ],
      "tips": "把括号连同前面的符号一起处理。"
    }
  ],
