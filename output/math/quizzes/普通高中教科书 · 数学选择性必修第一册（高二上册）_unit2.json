      "point": "椭圆",
      "core_concept": "平面内到两定点距离之和等于常数（大于两定点距离）的点的轨迹是椭圆。$a^2=b^2+c^2$，离心率 $e=\\frac ca\\in(0,1)$。",
      "key_formula": "$\\frac{x^2}{a^2}+\\frac{y^2}{b^2}=1$",
      "common_mistakes": [
        "把 $a^2=b^2+c^2$ 记成 $c^2=a^2+b^2$。"
      ],
      "tips": "椭圆中 $a$ 最大。"
    },
    {
      "point": "双曲线与抛物线",
      "core_concept": "双曲线：到两定点距离之差的绝对值为常数，$c^2=a^2+b^2$。抛物线 $y^2=2px$ 的焦点为 $(\\frac p2,0)$，准线 $x=-\\frac p2$。",
      "key_formula": "$y^2=2px$",
      "common_mistakes": [
        "双曲线中 $a$ 与 $c$ 关系记混。"
      ],
      "tips": "双曲线中 $c$ 最大。"
    }
