  "knowledge_summary": [
    {
      "point": "二次函数的图象与性质",
      "core_concept": "$y=ax^2+bx+c$ 的图象是抛物线；$a>0$ 开口向上，$a<0$ 开口向下；对称轴 $x=-\\frac{b}{2a}$，顶点纵坐标为 $\\frac{4ac-b^2}{4a}$。",
      "key_formula": "顶点 $( -\\frac{b}{2a},\\ \\frac{4ac-b^2}{4a} )$",
      "common_mistakes": [
        "对称轴符号写错。"
      ],
      "tips": "先求对称轴 $x=-\\frac{b}{2a}$。"
    },
    {
      "point": "二次函数解析式的确定",
      "core_concept": "已知三点用一般式；已知顶点用 $y=a(x-h)^2+k$；已知与 $x$ 轴交点用 $y=a(x-x_1)(x-x_2)$。",
      "key_formula": "$y=a(x-h)^2+k$",
      "common_mistakes": [
