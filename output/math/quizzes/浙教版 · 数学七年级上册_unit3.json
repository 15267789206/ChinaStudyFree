    {
      "point": "平方根与算术平方根",
      "core_concept": "若 $x^2=a$，则 $x$ 叫 $a$ 的平方根；正的非负数平方根记 $\\sqrt a$（算术平方根）。正数有两个互为相反数的平方根，0 的平方根是 0，负数没有平方根。",
      "key_formula": "$\\sqrt a\\ (a\\ge0)$",
      "common_mistakes": [
        "认为负数也有平方根。"
      ],
      "tips": "负数没有平方根。"
    },
    {
      "point": "实数与数轴",
      "core_concept": "无理数是无限不循环小数；有理数与无理数统称实数；实数与数轴上的点一一对应。",
      "key_formula": "实数 ↔ 数轴上的点",
      "common_mistakes": [
        "认为数轴上只有有理数。"
      ],
      "tips": "无理数也能在数轴上表示。"
    },
    {
      "point": "立方根与实数的运算",
      "core_concept": "若 $x^3=a$，则 $x$ 叫 $a$ 的立方根，记 $\\sqrt[3]a$；任何实数都有且只有一个立方根。实数大小比较：正数 > 0 > 负数，原点右边越大。",
      "key_formula": "$\\sqrt[3]a$",
      "common_mistakes": [
        "认为负数没有立方根。"
      ],
      "tips": "负数有立方根。"
    }
