  "knowledge_summary": [
    {
      "point": "轴对称与轴对称图形",
      "core_concept": "沿一条直线折叠，两部分能重合的图形是轴对称图形，这条直线是对称轴。轴对称的两个图形全等。",
      "key_formula": "对称轴垂直平分对称点连线",
      "common_mistakes": [
        "混淆轴对称图形与两个图形成轴对称。"
      ],
      "tips": "对称轴是直线不是线段。"
    },
    {
      "point": "线段垂直平分线",
      "core_concept": "线段垂直平分线上的点到线段两端距离相等；反之，到两端距离相等的点在垂直平分线上。",
      "key_formula": "PA=PB ⇔ P 在垂直平分线上",
      "common_mistakes": [
        "把垂直平分线与角平分线混淆。"
      ],
      "tips": "抓住“到两端等距”。"
    },
    {
      "point": "等腰三角形",
      "core_concept": "等腰三角形两腰相等、两底角相等（等边对等角）；顶角平分线、底边中线、底边高互相重合（三线合一）。",
      "key_formula": "等边对等角；三线合一",
      "common_mistakes": [
        "忘记分类讨论顶角与底角。"
      ],
      "tips": "遇等腰先考虑顶角、底角两种情形。"
    }
