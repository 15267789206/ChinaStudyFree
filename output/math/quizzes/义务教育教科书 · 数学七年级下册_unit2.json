  "knowledge_summary": [
    {
      "point": "平方根与立方根",
      "core_concept": "若 $x^2=a(a\\ge0)$，则 $x$ 是 $a$ 的平方根，其中非负的为算术平方根。正数有两个平方根，互为相反数。若 $x^3=a$，则 $x$ 是 $a$ 的立方根。",
      "key_formula": "$\\sqrt{a}\\ge0$；$\\sqrt[3]{-a}=-\\sqrt[3]{a}$",
      "common_mistakes": [
        "认为 $\\sqrt{9}=\\pm3$（算术平方根取非负）。"
      ],
      "tips": "注意正数平方根有两个，算术平方根只有一个。"
    },
    {
      "point": "无理数与实数",
      "core_concept": "无限不循环小数是无理数，如 $\\sqrt2$、$\\pi$。有理数和无理数统称实数，实数与数轴上的点一一对应。",
      "key_formula": "$\\sqrt2\\approx1.414$",
      "common_mistakes": [
        "把 $\\frac{22}{7}$ 当无理数（它是分数，有理数）。"
      ],
      "tips": "看能否写成分数形式。"
    },
    {
      "point": "实数的运算与估算",
      "core_concept": "实数的相反数、绝对值、运算律与有理数一致；可用夹逼法估算无理数的大小。",
      "key_formula": "$|a|$ 定义同有理数",
      "common_mistakes": [
        "估算时夹逼区间取错。"
      ],
      "tips": "用相邻完全平方数夹逼。"
    }
  ],
