    {
      "point": "几何图形与线",
      "core_concept": "几何图形分立体图形与平面图形；线段有两个端点、射线有一个端点、直线没有端点。两点确定一条直线。",
      "key_formula": "两点确定一条直线",
      "common_mistakes": [
        "认为直线可以度量。"
      ],
      "tips": "只有线段能量长度。"
    },
    {
      "point": "线段的长短比较与和差",
      "core_concept": "两点之间线段最短；用圆规截取可比较长短；线段和差：若 C 在 AB 上，则 AB = AC + CB。",
      "key_formula": "两点之间，线段最短",
      "common_mistakes": [
        "以为两点之间直线最短（直线无限延伸）。"
      ],
      "tips": "是「线段」最短。"
    },
    {
      "point": "角与角的度量、余角和补角",
      "core_concept": "角由有公共端点的两条射线组成；1° = 60′，1′ = 60″；余角和为 90°，补角和为 180°。",
      "key_formula": "$1^\\circ=60'$，$1'=60''$",
      "common_mistakes": [
        "余角与补角混淆。"
      ],
      "tips": "余 90 补 180。"
    }
