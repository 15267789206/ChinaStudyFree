      "key_formula": "数轴三要素",
      "common_mistakes": [
        "画数轴漏标单位长度。"
      ],
      "tips": "原点、正方向、单位长度缺一不可。"
    },
    {
      "point": "绝对值与有理数大小比较",
      "core_concept": "$|a|$ 表示数轴上 $a$ 到原点的距离。正数 > 0 > 负数；两个负数比较，绝对值大的反而小。",
      "key_formula": "$|a|\\ge0$",
      "common_mistakes": [
