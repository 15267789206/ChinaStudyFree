  "knowledge_summary": [
    {
      "point": "直线的方程与位置关系",
      "core_concept": "斜率 $k=\\frac{y_2-y_1}{x_2-x_1}$。点斜式 $y-y_0=k(x-x_0)$。两直线平行则斜率相等（或都不存在）；垂直则斜率之积为 $-1$。",
      "key_formula": "$k_1k_2=-1\\Leftrightarrow$ 垂直",
      "common_mistakes": [
        "忽略斜率不存在的情形。"
      ],
      "tips": "讨论斜率是否存在。"
    },
    {
      "point": "圆的方程",
      "core_concept": "标准方程 $(x-a)^2+(y-b)^2=r^2$，圆心 $(a,b)$、半径 $r$。一般方程 $x^2+y^2+Dx+Ey+F=0$ 需 $D^2+E^2-4F>0$。",
      "key_formula": "$(x-a)^2+(y-b)^2=r^2$",
      "common_mistakes": [
        "配方时符号出错。"
      ],
      "tips": "配方求圆心半径。"
    }
