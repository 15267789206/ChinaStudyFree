  "knowledge_summary": [
    {
      "point": "方程与一元一次方程",
      "core_concept": "含未知数的等式叫方程；只含一个未知数、次数为1、两边都是整式的方程叫一元一次方程。",
      "key_formula": "$ax+b=0\\ (a\\ne0)$",
      "common_mistakes": [
        "把 $\\frac1x=2$ 当一元一次方程。"
      ],
      "tips": "看三点：一个未知数、次数1、整式。"
    },
    {
      "point": "等式的性质与解方程",
      "core_concept": "等式两边同加(减)同一个数或式子仍相等；两边同乘(除以非零数)仍相等。移项要变号。",
      "key_formula": "$a=b\\Rightarrow a\\pm c=b\\pm c$",
      "common_mistakes": [
        "移项忘记变号。"
      ],
      "tips": "移项=过桥变号。"
    },
    {
      "point": "列方程解应用题",
      "core_concept": "找等量关系是核心。常见模型：和差倍分、行程($s=vt$)、工程、销售。",
      "key_formula": "$s=vt$",
      "common_mistakes": [
        "单位不统一。"
      ],
      "tips": "先找等量关系再设未知数。"
    }
  ],
