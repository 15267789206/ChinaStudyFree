    {
      "point": "呼吸系统与血液循环",
      "core_concept": "呼吸系统由呼吸道和肺组成，肺泡适于气体交换。血液由血浆和血细胞组成，红细胞含血红蛋白运输氧气。血液循环分体循环与肺循环。",
      "key_formula": "体循环：左心室→主动脉→…→右心房",
      "common_mistakes": [
        "认为动脉里一定流动脉血。"
      ],
      "tips": "肺动脉里流静脉血。"
    },
    {
      "point": "泌尿系统与排泄",
      "core_concept": "泌尿系统由肾脏、输尿管、膀胱、尿道组成。尿液形成经肾小球滤过和肾小管重吸收两个过程。",
      "key_formula": "肾小球滤过 + 肾小管重吸收",
      "common_mistakes": [
        "认为原尿中含大量血细胞。"
      ],
      "tips": "正常尿液中无血细胞与葡萄糖。"
    }
