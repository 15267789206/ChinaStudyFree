  "knowledge_summary": [
    {
      "point": "DNA 的结构与复制",
      "core_concept": "DNA 是规则的双螺旋结构，碱基遵循 A-T、G-C 互补配对。复制方式为半保留复制，需要模板、原料、能量和酶。",
      "key_formula": "$n$ 次复制后 DNA 数为 $2^n$",
      "common_mistakes": [
        "认为复制是全保留。"
      ],
      "tips": "每个子代 DNA 含一条母链。"
    },
    {
      "point": "基因的表达与变异",
      "core_concept": "转录在细胞核中以 DNA 为模板合成 mRNA；翻译在核糖体上以 mRNA 为模板合成蛋白质。基因突变是指 DNA 分子中碱基对的替换、增添或缺失。",
      "key_formula": "DNA → mRNA → 蛋白质",
      "common_mistakes": [
        "把转录与翻译场所混淆。"
      ],
      "tips": "转录在核，翻译在核糖体。"
    }
  ],
