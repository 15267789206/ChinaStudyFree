    {
      "point": "脊椎动物的主要类群",
      "core_concept": "脊椎动物包括鱼纲、两栖纲、爬行纲、鸟纲、哺乳纲。鱼用鳃呼吸靠鳍运动；两栖类幼体用鳃、成体用肺兼皮肤；爬行类用肺、鳞片防水；鸟类体表被羽有气囊辅助呼吸；哺乳类用肺、胎生哺乳。",
      "key_formula": "五类脊椎动物",
      "common_mistakes": [
        "把两栖类当成爬行类。"
      ],
      "tips": "两栖类“幼鳃成肺兼皮”。"
    },
    {
      "point": "无脊椎动物与分类",
      "core_concept": "无脊椎动物包括腔肠动物、扁形动物、线形动物、环节动物、软体动物、节肢动物等。分类依据有形态结构、生活习性、亲缘关系。",
      "key_formula": "节肢动物：外骨骼 + 附肢分节",
      "common_mistakes": [
        "把环节动物与节肢动物混淆。"
      ],
      "tips": "蚯蚓属环节动物。"
    }
