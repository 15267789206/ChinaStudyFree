  "knowledge_summary": [
    {
      "point": "功、功率与动能定理",
      "core_concept": "合外力做的功等于物体动能的变化量：$W_\\text{合}=\\frac12mv_2^2-\\frac12mv_1^2$。$P=\\frac Wt=Fv$。",
      "key_formula": "$W_\\text{合}=\\Delta E_k$",
      "common_mistakes": [
        "忘记摩擦力做负功。"
      ],
      "tips": "先算合外力功。"
    },
    {
      "point": "机械能守恒定律",
      "core_concept": "只有重力（或弹力）做功时，物体的动能与势能相互转化，机械能总量保持不变。$E_{k1}+E_{p1}=E_{k2}+E_{p2}$。",
      "key_formula": "$mgh_1+\\frac12mv_1^2=mgh_2+\\frac12mv_2^2$",
      "common_mistakes": [
        "有摩擦时仍用机械能守恒。"
      ],
      "tips": "先验证守恒条件。"
    }
