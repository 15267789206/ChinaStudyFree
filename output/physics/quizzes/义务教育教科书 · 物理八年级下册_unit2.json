  "knowledge_summary": [
    {
      "point": "压强",
      "core_concept": "物体所受压力与受力面积之比叫压强。增大压强可减小受力面积或增大压力。",
      "key_formula": "$p=\\frac FS$",
      "common_mistakes": [
        "受力面积用错（应为接触面积）。"
      ],
      "tips": "单位 Pa = N/m²。"
    },
    {
      "point": "液体的压强",
      "core_concept": "液体内部向各个方向都有压强，压强随深度增加而增大；同一深度处各方向压强相等。",
      "key_formula": "$p=\\rho gh$",
      "common_mistakes": [
        "把 $h$ 当成容器高度。"
      ],
      "tips": "$h$ 是液面到该点的竖直深度。"
    },
    {
      "point": "阿基米德原理与浮沉条件",
      "core_concept": "浮力等于物体排开液体所受的重力。$F_\\text{浮}>G$ 上浮，$=$ 悬浮，$<$ 下沉。",
      "key_formula": "$F_\\text{浮}=\\rho_\\text{液}gV_\\text{排}$",
      "common_mistakes": [
        "把 $V_\\text{排}$ 当成物体总体积。"
      ],
      "tips": "漂浮时 $V_\\text{排}<V_\\text{物}$。"
    }
  ],
