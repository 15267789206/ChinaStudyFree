  "knowledge_summary": [
    {
      "point": "匀变速直线运动规律",
      "core_concept": "$v=v_0+at$，$x=v_0t+\\frac12at^2$，$v^2-v_0^2=2ax$。匀变速直线运动中间时刻速度等于该段平均速度。",
      "key_formula": "$v^2-v_0^2=2ax$",
      "common_mistakes": [
        "忘记速度与位移的平方关系。"
      ],
      "tips": "先判断初速度方向为正。"
    },
    {
      "point": "自由落体与运动图象",
      "core_concept": "自由落体是初速度为 0、加速度为 $g$ 的匀加速运动，$h=\\frac12gt^2$，$v=gt$。$v-t$ 图象的斜率表示加速度，面积表示位移。",
      "key_formula": "$h=\\frac12gt^2$",
      "common_mistakes": [
        "把图象面积当作速度。"
      ],
      "tips": "面积即位移。"
