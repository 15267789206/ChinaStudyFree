    {
      "point": "光的直线传播与反射",
      "core_concept": "光在同种均匀介质中沿直线传播。反射定律：反射光线、入射光线、法线在同一平面内，反射光线与入射光线分居法线两侧，反射角等于入射角。",
      "key_formula": "反射角 = 入射角",
      "common_mistakes": [
        "把入射角当作与镜面的夹角。"
      ],
      "tips": "角一律与法线比较。"
    },
    {
      "point": "平面镜成像",
      "core_concept": "平面镜成正立、等大的虚像，像与物到镜面距离相等，像与物关于镜面对称。",
      "key_formula": "像距 = 物距",
      "common_mistakes": [
        "认为像会随距离变小。"
      ],
      "tips": "像与物大小始终相等。"
    },
    {
      "point": "光的折射",
      "core_concept": "光从空气斜射入水或玻璃时，折射光线向法线偏折，折射角小于入射角；反之折射角大于入射角。",
      "key_formula": "空气→水：折射角 < 入射角",
      "common_mistakes": [
        "认为折射角总是小于入射角。"
      ],
      "tips": "光在空气中那侧的角更大。"
    }
  ],
