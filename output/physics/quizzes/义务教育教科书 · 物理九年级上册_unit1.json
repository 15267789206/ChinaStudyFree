  "knowledge_summary": [
    {
      "point": "分子热运动与内能",
      "core_concept": "物质由分子构成，分子永不停息做无规则运动（热运动），温度越高运动越剧烈。内能是物体内所有分子动能与势能之和。",
      "key_formula": "温度升高 ⇒ 内能增大",
      "common_mistakes": [
        "认为 0℃ 的物体没有内能。"
      ],
      "tips": "任何物体都有内能。"
    },
    {
      "point": "比热容与热量的计算",
      "core_concept": "比热容是单位质量物质温度升高 1℃ 吸收的热量，是物质的特性。水的比热容大（$4.2\\times10^3\\ \\text{J/(kg·℃)}$），常作冷却剂。",
      "key_formula": "$Q=cm\\Delta t$",
      "common_mistakes": [
        "$\\Delta t$ 与末温混淆。"
      ],
      "tips": "$\\Delta t$ 是温度变化量。"
    },
    {
      "point": "热机与能量转化",
      "core_concept": "四冲程内燃机工作循环：吸气、压缩、做功、排气，一个循环曲轴转 2 圈、做功 1 次。热机效率 $\\eta=\\frac{W_\\text{有用}}{Q_\\text{总}}$。",
      "key_formula": "$\\eta=\\frac{W_\\text{有用}}{Q_\\text{总}}\\times100\\%$",
      "common_mistakes": [
