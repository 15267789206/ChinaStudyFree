  "knowledge_summary": [
    {
      "point": "功与功率",
      "core_concept": "功等于力与物体在力的方向上移动距离的乘积。有力无距离或有距离无力都不做功。",
      "key_formula": "$W=Fs$，$P=\\frac Wt$",
      "common_mistakes": [
        "把竖直提力与水平位移相乘。"
      ],
      "tips": "力与距离必须同方向。"
    },
    {
      "point": "动能与势能",
      "core_concept": "动能大小与质量和速度有关（质量越大、速度越大动能越大）；重力势能与质量和高度有关；弹性势能与弹性形变程度有关。",
      "key_formula": "$E_k$ 与 $m$、$v$ 有关",
      "common_mistakes": [
        "认为动能只与速度有关。"
      ],
      "tips": "机械能 = 动能 + 势能。"
    },
    {
      "point": "机械能及其转化",
      "core_concept": "动能与势能可以相互转化；若只有动能和势能相互转化，机械能总量保持不变。",
      "key_formula": "$E_k+E_p=\\text{常量}$（不计阻力）",
      "common_mistakes": [
        "忽略摩擦损耗。"
      ],
      "tips": "自由下落：重力势能 → 动能。"
    }
  ],
