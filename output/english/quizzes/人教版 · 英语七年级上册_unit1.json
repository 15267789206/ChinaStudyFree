    {
      "point": "名词与冠词",
      "core_concept": "可数名词有单复数形式，一般加 -s/-es。a/an 表示泛指，an 用于元音音素开头的词前；the 表示特指。",
      "key_formula": "an + 元音音素开头",
      "common_mistakes": [
        "a useful book（u 发 /j/，用 a）。"
      ],
      "tips": "看读音不看字母。"
    },
    {
      "point": "代词与数词",
      "core_concept": "人称代词主格作主语、宾格作宾语；形容词性物主代词后接名词，名词性物主代词单独使用。",
      "key_formula": "my book = mine",
      "common_mistakes": [
        "混用 its 与 it's。"
      ],
      "tips": "it's = it is。"
