  "knowledge_summary": [
    {
      "point": "从句与虚拟语气",
      "core_concept": "名词性从句包括主语、宾语、表语、同位语从句。虚拟语气中，与现在事实相反用过去式，与过去事实相反用过去完成式。",
      "key_formula": "If I were you, I would…",
      "common_mistakes": [
        "虚拟语气中误用 was。"
      ],
      "tips": "虚拟中 be 动词用 were。"
    },
    {
      "point": "非谓语与倒装",
      "core_concept": "非谓语形式作状语时，逻辑主语与句子主语一致。否定词置于句首时用部分倒装；only 修饰状语置于句首也用倒装。",
      "key_formula": "Never have I seen…",
      "common_mistakes": [
        "倒装时忘记助动词。"
      ],
      "tips": "倒装 = 助动词提前。"
    }
  ],
