  "knowledge_summary": [
    {
      "point": "时间、条件与结果状语从句",
      "core_concept": "时间状语从句用 when、while、as soon as、until 等；条件状语从句用 if、unless；结果状语从句用 so…that、such…that。主句将来时，从句一般用一般现在时。",
      "key_formula": "主将从现",
      "common_mistakes": [
        "从句用 will。"
      ],
      "tips": "主将从现。"
    },
    {
      "point": "让步与宾语从句",
      "core_concept": "让步状语从句用 although/though/even if，但与 but 不能同时使用。宾语从句用陈述语序，时态呼应主句。",
      "key_formula": "although … but ✗",
      "common_mistakes": [
        "although 与 but 连用。"
      ],
      "tips": "二者不能连用。"
    }
