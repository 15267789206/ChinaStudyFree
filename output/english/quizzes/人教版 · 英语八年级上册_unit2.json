  "knowledge_summary": [
    {
      "point": "一般过去时",
      "core_concept": "一般过去时表示过去发生的动作。规则动词加 -ed；不规则动词需逐个记忆，如 go-went、see-saw。",
      "key_formula": "动词过去式",
      "common_mistakes": [
        "不规则动词随便加 -ed。"
      ],
      "tips": "不规则动词要专门记。"
    },
    {
      "point": "一般将来时",
      "core_concept": "will 表示单纯的将来或临时决定；be going to 表示计划打算或有迹象即将发生。",
      "key_formula": "will do / be going to do",
      "common_mistakes": [
        "两种表达混用不分。"
      ],
      "tips": "will 重将来，going to 重打算。"
    }
  ],
