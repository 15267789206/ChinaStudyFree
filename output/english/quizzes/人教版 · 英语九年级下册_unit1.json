  "knowledge_summary": [
    {
      "point": "现在完成时",
      "core_concept": "现在完成时由 have/has + 过去分词构成，表示过去动作对现在的影响或持续到现在。since 后接时间点，for 后接时间段。",
      "key_formula": "have/has + 过去分词",
      "common_mistakes": [
        "与一般过去时混用。"
      ],
      "tips": "since 时间点，for 时间段。"
    },
    {
      "point": "被动语态综合",
      "core_concept": "被动语态强调动作承受者。常与 by 短语搭配说明动作发出者，或不出现 by 说明不必/无从说明。",
      "key_formula": "be + 过去分词 (+ by …)",
      "common_mistakes": [
        "主动句直接套用被动结构。"
      ],
      "tips": "先判断主语是不是承受者。"
    }
  ],
