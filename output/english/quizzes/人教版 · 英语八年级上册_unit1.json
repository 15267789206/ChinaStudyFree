    {
      "point": "一般现在时",
      "core_concept": "一般现在时表示经常性动作或客观事实。否定和疑问要借助助动词 do/does，第三人称单数动词加 -s/-es。",
      "key_formula": "do/does + 动词原形",
      "common_mistakes": [
        "第三人称单数忘记加 -s。"
      ],
      "tips": "助动词后用原形。"
    },
    {
      "point": "现在进行时",
      "core_concept": "现在进行时表示此刻正在进行的动作，由 be + 动词 -ing 构成，常与 now、at the moment 连用。",
      "key_formula": "be + 动词-ing",
      "common_mistakes": [
        "与一般现在时的用法混淆。"
      ],
      "tips": "看时间标志词。"
    }
  ],
