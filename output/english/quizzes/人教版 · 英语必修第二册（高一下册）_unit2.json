    {
      "point": "限制性定语从句",
      "core_concept": "定语从句修饰先行词，关系词有 who/which/that（指人/物）、whose（所属关系）、where（地点）、when（时间）。先行词指人用 who，物用 which/that。",
      "key_formula": "先行词 + 关系词 + 从句",
      "common_mistakes": [
        "先行词指物却用 who。"
      ],
      "tips": "看先行词定关系词。"
    },
    {
      "point": "非限制性定语从句",
      "core_concept": "限制性从句不能删去，限定范围；非限制性从句是补充说明，逗号隔开，可删去而不影响主句意思。",
      "key_formula": "有逗号 = 非限制性",
      "common_mistakes": [
        "两者混用。"
      ],
      "tips": "逗号是关键标志。"
