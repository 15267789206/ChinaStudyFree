    {
      "point": "溶液的形成与溶解度",
      "core_concept": "溶液是均一、稳定的混合物。在一定温度下，某固态物质在 100 g 溶剂里达到饱和状态时所溶解的质量叫溶解度。大多数固体溶解度随温度升高而增大。",
      "key_formula": "溶解度单位：g/100 g 水",
      "common_mistakes": [
        "把溶解度与溶质质量分数混淆。"
      ],
      "tips": "溶解度必须指明温度。"
    },
    {
      "point": "溶质质量分数",
      "core_concept": "溶质质量分数 = 溶质质量 / 溶液质量 × 100%。稀释前后溶质质量不变。",
      "key_formula": "$w=\\frac{m_\\text{质}}{m_\\text{液}}\\times100\\%$",
      "common_mistakes": [
        "分母用溶剂质量。"
      ],
      "tips": "分母是溶液质量。"
    }
